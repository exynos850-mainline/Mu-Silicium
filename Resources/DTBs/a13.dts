	dpm {
		version = <0x64>;
		chip-id = <0xef6>;

		security {
			cp_mem_not_clear = <0x00>;
			dbg_mem_enable = <0x00>;
			seh_enable = <0x00>;
			pm_test_enable = <0x00>;
			seclog_enable = <0x00>;
			sdm_enable = <0x00>;
		};

		feature {

			debug {
				enabled = <0x01>;
			};

			dump-mode {
				enabled = <0x01>;
				file-support = <0x00>;
			};

			dss {
				method = "log_kernel\0log_platform\0log_kevents\0log_fatal\0log_pstore\0log_sfr\0log_arrdumpreset\0log_bcm";

				event {
					method = "task_log\0work_log\0cpuidle_log\0suspend_log\0irq_log\0spinlock_log\0reg_log\0hrtimer_log\0clk_log\0pmu_log\0freq_log\0dm_log\0regulator_log\0thermal_log\0i2c_log\0spi_log\0binder_log\0acpm_log\0printk_log\0printkl_log";
				};
			};
		};

		policy {

			exception {
				pre_log = <0x01>;
				el1_da = <0x00>;
				el1_ia = <0x00>;
				el1_undef = <0x00>;
				el1_sp_pc = <0x00>;
				el1_inv = <0x00>;
				el1_serror = <0x00>;
			};

			itmon {
				err_fatal = <0x01>;
				err_drex_tmout = <0x01>;
				err_ip = <0x01>;
				err_cpu = <0x00>;
				err_cp = <0x00>;
				err_chub = <0x00>;
			};
		};

		config {

			itmon {
				panic_count = <0x03>;
				panic_count_cpu = <0x03>;
			};
		};
	};

