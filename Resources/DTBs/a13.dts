		compatible = "samsung,audio-debug";
		status = "okay";
		abox_dbg_size_min = <0x400000>;
		abox_slog_size_min = <0x00>;
	};

	hs_tune {
		status = "disabled";
		hs_tune_cnt = <0x0a>;
		phandle = <0x1ac>;

		hs_tune1 {
			tune_name = "tx_pre_emp";
			tune_value = <0x03 0x03>;
		};

		hs_tune2 {
			tune_name = "tx_pre_emp_plus";
			tune_value = <0x00 0x00>;
		};

