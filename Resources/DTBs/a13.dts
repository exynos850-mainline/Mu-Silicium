	usb_notifier {
		compatible = "samsung,usb-notifier";
		udc = <0x146>;
	};

	argos {
		compatible = "samsung,argos";
		#address-cells = <0x01>;

		boot_device@1 {
			net_boost,label = "IPC";
			net_boost,node = "rmnet0 rmnet1 rmnet2 rmnet3 rmnet4 rmnet5 rmnet6 rmnet7 umts_dm0";

			net_boost,table {

				level_0 {
					threshold = <0x64>;
					lit_min = <0x101148>;
				};

				level_1 {
					threshold = <0xc8>;
					lit_min = <0x13d620>;
					mif = <0xf78f0>;
				};

				level_2 {
					threshold = <0x12c>;
					big_min = <0x13d620>;
					lit_min = <0x13d620>;
					mif = <0xf78f0>;
				};
			};
		};

		boot_device@2 {
			net_boost,label = "WIFI";
			net_boost,node = "wlan0";

			net_boost,table {

				level_0 {
					threshold = <0xc8>;
					big_min = <0x1c2af0>;
					lit_min = <0x1c2af0>;
				};
			};
		};
	};

	lcd_fixed_regulator {
		compatible = "simple-bus";
		phandle = <0x1da>;

		__gpio_lcd_rst {
			compatible = "regulator-fixed";
			regulator-name = "lcd_rst";
			gpio = <0x87 0x04 0x00>;
			enable-active-high;
			regulator-boot-on;
			phandle = <0x1db>;
		};

		__gpio_lcd_bl_en {
			compatible = "regulator-fixed";
			regulator-name = "lcd_bl_en";
			gpio = <0x87 0x01 0x00>;
			enable-active-high;
			regulator-boot-on;
			phandle = <0x1dc>;
		};

		__gpio_lcd_vsp {
			compatible = "regulator-fixed";
			regulator-name = "lcd_vsp";
			gpio = <0x92 0x00 0x00>;
			enable-active-high;
			regulator-boot-on;
			phandle = <0x1dd>;
		};

		__gpio_lcd_vsn {
			compatible = "regulator-fixed";
			regulator-name = "lcd_vsn";
			gpio = <0xc7 0x00 0x00>;
			enable-active-high;
			regulator-boot-on;
			phandle = <0x1de>;
		};
	};

