			phandle = <0x166>;
		};

		nt36523_tsp_rst_sleep {
			samsung,pins = "gpa3-0";
			samsung,pin-function = <0x00>;
			samsung,pin-pud = <0x01>;
			samsung,pin-drv = <0x00>;
			phandle = <0x168>;
		};

		typec_int {
