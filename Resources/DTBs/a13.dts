	pinctrl@11c30000 {
		compatible = "samsung,exynos3830-pinctrl";
		reg = <0x00 0x11c30000 0x1000>;
		interrupts = <0x00 0x27 0x04 0x00 0x28 0x04 0x00 0x29 0x04 0x00 0x2a 0x04 0x00 0x2b 0x04 0x00 0x2c 0x04 0x00 0x2d 0x04>;
