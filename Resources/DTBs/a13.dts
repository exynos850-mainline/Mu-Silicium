			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x8d>;
		};

		uart0-bus {
			samsung,pins = "gpq0-0\0gpq0-1";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x03>;
			phandle = <0x1b>;
		};

		decon_f_te_on {
			samsung,pins = "gpa4-1";
			samsung,pin-function = <0x0f>;
			phandle = <0x0a>;
		};

		decon_f_te_off {
			samsung,pins = "gpa4-1";
			samsung,pin-function = <0x00>;
			phandle = <0x0b>;
		};

		i2c5-bus {
			samsung,pins = "gpa3-5\0gpa3-6";
			samsung,pin-function = <0x03>;
			samsung,pin-pud = <0x03>;
			samsung,pin-drv = <0x00>;
			phandle = <0x2c>;
		};

		i2c6-bus {
			samsung,pins = "gpa3-7\0gpa4-0";
			samsung,pin-function = <0x03>;
			samsung,pin-pud = <0x03>;
			samsung,pin-drv = <0x00>;
			phandle = <0x2e>;
		};

		wlbt_femctrl_00 {
			samsung,pins = "gpa4-0";
			samsung,pin-function = <0x02>;
			samsung,pin-pud = <0x01>;
			samsung,pin-drv = <0x02>;
			phandle = <0x8e>;
		};

		wakeup-interrupt-controller {
			compatible = "samsung,exynos7-wakeup-eint";
		};

		afc_output {
			samsung,pins = "gpa1-1";
			samsung,pin-function = <0x01>;
			samsung,pin-pud = <0x00>;
			samsung,pin-drv = <0x04>;
			phandle = <0x153>;
